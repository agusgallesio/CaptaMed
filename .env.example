# ---- Asistente de IA: configurá UNA de las dos opciones ----
# Opción A (recomendada): Claude — mejor calidad de análisis. Requiere crédito.
ANTHROPIC_API_KEY=sk-ant-...
# Opción B (gratis): Google Gemini — key sin tarjeta en https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Si tenés ambas keys, podés forzar el proveedor: "anthropic" o "gemini"
# AI_PROVIDER=

# ---- Meta Marketing API (opcional: sin Meta+Kommo se usan datos demo) ----
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890

# ---- Google Ads API (opcional, se suma a Meta cuando está configurado) ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Kommo CRM (opcional: sin esto se usan datos demo) ----
KOMMO_BASE_URL=https://tuclinica.kommo.com
KOMMO_ACCESS_TOKEN=

# IDs de estado del pipeline de Kommo (ver GET /api/v4/leads/pipelines)
# Listas separadas por coma. 142 (ganado) y 143 (perdido) son estándar.
KOMMO_STATUS_CONTACTADO=
KOMMO_STATUS_AGENDADO=
KOMMO_STATUS_ASISTIO=
